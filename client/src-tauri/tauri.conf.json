{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "goodbyedc",
  "version": "0.1.0",
  "identifier": "com.goodbyedc.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "goodbyedc",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.3"
    }
  }
}
